# Server-side only: read by api/character.js, never sent to the page.
# The page receives a short-lived Convai auth token minted from these keys.

# Convai Cloud
CONVAI_API_KEY=
CONVAI_CHARACTER_ID=

# On-prem install: its URL (https://api-<env>.<domain>), a key issued by that
# install, and a character on it. Keys and character ids are per deployment.
CONVAI_ONPREM_URL=
CONVAI_ONPREM_API_KEY=
CONVAI_ONPREM_CHARACTER_ID=
