# The install's Middleman URL: https://api-<env>.<domain>. Embody derives
# live-<env> (realtime) and character-apis-<env> (Character API) from it.
VITE_CONVAI_ONPREM_URL=https://api-sh-aws.convai.com
# An API key issued by that install (never a SaaS key: character ids and keys are per install).
VITE_CONVAI_API_KEY=
# A character on that install whose avatar has a published web body.
VITE_CONVAI_CHARACTER_ID=
